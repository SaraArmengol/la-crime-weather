# Copy this file to .env and fill in values. Never commit .env.

# Optional: Socrata app token for data.lacity.org (raises rate limits).
# Get one free at https://data.lacity.org/profile/edit/developer_settings
SOCRATA_APP_TOKEN=

# Only needed if you switch to a weather provider that requires a key.
# Open-Meteo (the default) does not.
WEATHER_API_KEY=
